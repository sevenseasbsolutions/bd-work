# Copy to backend/.env and fill in. Read by bd-work-api.service (EnvironmentFile).
# Keep .env out of git and chmod 600 — it holds secrets.

# --- Required -------------------------------------------------------------- #

# Local PostgreSQL. deploy/setup.sh creates the `bdwork` role with this password.
MBS_DATABASE_URL=postgresql+psycopg2://bdwork:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/bdwork

# Signs login tokens. Generate with: openssl rand -hex 32
MBS_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# First manager account, created only on an empty database.
# Remove the password once you have signed in and changed it.
MBS_ADMIN_EMAIL=admin@example.com
MBS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

PYTHONUNBUFFERED=1

# --- Optional: Google Sheet mirror ----------------------------------------- #

# Service account: a path to its JSON key file, or the JSON itself.
# MBS_GOOGLE_CREDENTIALS=/home/server/bd-work/backend/service-account.json
# MBS_SHEET_ID=your-spreadsheet-id
# MBS_MANAGER_SHEET_ID=your-manager-spreadsheet-id

# Seconds between appends / manager-tab rewrites / full rebuilds.
# MBS_SHEET_INTERVAL=5
# MBS_SHEET_REWRITE=300
# MBS_SHEET_REBUILD=3600
