[Unit]
Description=BD Work API (FastAPI/uvicorn, behind nginx at server.idsservices.us/api)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
# app/main.py opens the database on import; retry through a slow Postgres start.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=server
Group=server
WorkingDirectory=/home/server/bd-work/backend
EnvironmentFile=/home/server/bd-work/backend/.env
# One worker only: the Google Sheet sync holds an in-process lock.
# Localhost only; nginx is the sole client.
ExecStart=/home/server/bd-work/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8010 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
